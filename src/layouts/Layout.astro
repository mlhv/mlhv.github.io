---
import "../styles/theme.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<!-- TODO(hands-on): import and render the Nav component here -->
		<slot />
	</body>
</html>

<style>
	/* TODO(hands-on): theme tokens (:root custom properties for light/dark
	   palettes, typography) go here or in a dedicated global stylesheet
	   imported by this layout. */

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: var(--font-silkscreen);
	}
</style>
