<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
	<span class="icon" aria-hidden="true"></span>
	<span class="label">Dark mode</span>
</button>

<script>
	import { resolveTheme } from "../lib/theme";

	const STORAGE_KEY = "theme";

	const readStored = (): "light" | "dark" | null => {
		try {
			const value = localStorage.getItem(STORAGE_KEY);
			return value === "light" || value === "dark" ? value : null;
		} catch {
			return null;
		}
	};

	const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
	const currentTheme = () => resolveTheme(readStored(), systemDark.matches);

	// The button is re-rendered on every ClientRouter navigation, so look it up fresh each time.
	const getButton = () => document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
	const render = () => getButton()?.setAttribute("aria-pressed", String(currentTheme() === "dark"));

	document.addEventListener("astro:page-load", () => {
		getButton()?.addEventListener("click", () => {
			const next = currentTheme() === "dark" ? "light" : "dark";
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem(STORAGE_KEY, next);
			} catch {}
			render();
		});
		render();
	});

	// With no stored choice the page follows the OS theme, so keep the button state in step with it.
	systemDark.addEventListener("change", render);
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.75rem;
		font: inherit;
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-foreground);
		background: var(--color-background);
		border: 2px solid var(--color-foreground);
		border-radius: 999px;
		box-shadow: 3px 3px 0 var(--color-foreground);
		cursor: pointer;
	}

	.theme-toggle:active {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 var(--color-foreground);
	}

	.icon::before {
		content: "☾";
	}

	.theme-toggle[aria-pressed="true"] .icon::before {
		content: "☀";
	}
</style>
