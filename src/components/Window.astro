---
interface Props {
	title: string;
	/** When set, the whole window is a link. Don't put other links inside it. */
	href?: string;
	headingLevel?: 2 | 3;
	/** Title bar colour: the green accent (default) or the blue secondary. */
	tone?: "accent" | "secondary";
}

const { title, href, headingLevel = 2, tone = "accent" } = Astro.props;
const Tag = href ? "a" : "section";
const Heading = `h${headingLevel}` as "h2" | "h3";
// Names the whole-card link by its title alone, not title + description + tags.
// Derived from href so builds are deterministic; each Window links somewhere different.
const titleId = href ? `window-title-${href.replace(/[^a-z0-9]+/gi, "-").replace(/^-+|-+$/g, "") || "home"}` : undefined;
---

<Tag class:list={["window", `tone-${tone}`]} href={href} aria-labelledby={titleId}>
	<div class="titlebar">
		<Heading class="title" id={titleId}>{title}</Heading>
		<span class="controls" aria-hidden="true"><span></span><span></span><span></span></span>
	</div>
	<div class="body">
		<slot />
	</div>
</Tag>

<style>
	.window {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: var(--color-foreground);
		text-decoration: none;
		overflow: hidden;
		background: var(--color-surface);
		border: 3px solid var(--color-foreground);
		border-radius: var(--radius);
		box-shadow: 6px 6px 0 var(--color-foreground);
		transition:
			transform 120ms ease,
			box-shadow 120ms ease;
	}

	a.window:hover,
	a.window:focus-visible {
		outline: none;
		transform: translate(-2px, -2px);
		box-shadow: 8px 8px 0 var(--color-accent);
	}

	a.window:focus-visible {
		border-color: var(--color-accent);
	}

	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.4rem 0.75rem;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border-bottom: 3px solid var(--color-foreground);
	}

	.tone-secondary .titlebar {
		background: var(--color-secondary);
		color: var(--color-on-secondary);
	}

	.title {
		margin: 0;
		font-size: 1.05rem;
	}

	.controls {
		display: flex;
		flex-shrink: 0;
		gap: 4px;
	}

	.controls span {
		width: 10px;
		height: 10px;
		background: currentColor;
		border: 2px solid var(--color-foreground);
		border-radius: 50%;
	}

	.body {
		flex: 1;
		padding: 1rem;
	}
</style>
