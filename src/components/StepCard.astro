---
// One Step of the homepage Stage: a full-height section holding one glass card.
// The card fades in only once the Stage script has started (:root[data-stage]); without JS every card is simply visible.
import { kicker, type Step, type StepId } from "../stage/steps";

interface Props {
	id: StepId;
	/** The Steps the page shows, for numbering the kicker. */
	steps: readonly Step[];
	/** Centre the card's text (the Hello card). */
	center?: boolean;
}

const { id, steps, center = false } = Astro.props;
---

<section class="step" id={id} data-step>
	<div class:list={["card", { center }]} data-world-solid>
		<p class="kicker">{kicker(steps, id)}</p>
		<slot />
	</div>
	<slot name="after" />
</section>

<style>
	.step {
		display: grid;
		place-items: center;
		align-content: center;
		gap: 1rem;
		min-height: 100svh;
		padding-block: 2rem;
	}

	.card {
		width: min(40rem, 100%);
		padding: clamp(1.25rem, 4vw, 2rem);
		color: var(--color-on-glass);
		background: var(--color-glass);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border: 1.5px solid var(--color-glass-border);
		border-radius: var(--radius);
		box-shadow: 0 12px 40px rgb(0 0 0 / 0.25);
	}

	.center {
		text-align: center;
	}

	.kicker {
		margin: 0 0 0.5rem;
		max-width: none;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-glass-accent);
	}

	.card :global(h2) {
		margin: 0 0 1.25rem;
		font-size: clamp(1.6rem, 5vw, 2.2rem);
	}

	.card :global(a) {
		color: var(--color-glass-accent);
	}

	.card :global(:focus-visible) {
		outline-color: var(--color-glass-accent);
	}

	/* Reveal: only the active Step's card shows. Faded cards stay in the accessibility tree. */
	:global(:root[data-stage]) .card {
		transition:
			opacity 500ms ease-out,
			transform 500ms ease-out;
	}

	:global(:root[data-stage]) .step:not([data-active]) .card {
		opacity: 0;
		transform: translateY(2rem);
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(:root[data-stage]) .card {
			transition: none;
		}

		:global(:root[data-stage]) .step:not([data-active]) .card {
			opacity: 0.15;
			transform: none;
			/* Dimmed cards are inert to the pointer too: World would treat a tap there as solid, and they read as disabled.
			   Keyboard focus still reaches them and activates the Step. */
			pointer-events: none;
		}
	}

	@media (min-width: 768px) and (min-height: 600px) and (prefers-reduced-motion: no-preference) {
		/* Mandatory: a scroll that stops between two Steps always settles on whichever one fills more of the screen.
		   A Step taller than the screen still scrolls freely inside (browsers don't snap within an oversized snap area). */
		:global(:root[data-stage]) {
			scroll-snap-type: y mandatory;
		}

		.step {
			scroll-snap-align: center;
		}

		/* Without its own snap point the top of the page snaps back to Hello, so the nav and theme toggle could never be scrolled to. */
		:global(:root[data-stage] .site-header) {
			scroll-snap-align: start;
		}
	}
</style>
