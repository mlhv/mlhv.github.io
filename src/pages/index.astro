---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import headshot from "../assets/headshot.jpeg";
import ProjectLinks from "../components/ProjectLinks.astro";
import ProjectLogo from "../components/ProjectLogo.astro";
import Stage from "../components/Stage.astro";
import StepCard from "../components/StepCard.astro";
import World from "../components/World.astro";
import Layout from "../layouts/Layout.astro";
import { getVisiblePosts } from "../lib/content";
import { sortProjects } from "../lib/projects";
import { resume } from "../lib/resume-data";
import { stageSteps } from "../stage/steps";
import { cast, showHosts } from "../world/characters";
import { creditLines } from "../world/credits";

const projects = sortProjects(await getCollection("projects")).slice(0, 3);
const allPosts = await getVisiblePosts();
const posts = allPosts.slice(0, 2);
const steps = stageSteps(allPosts.length);
const formatDate = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" });
const credits = creditLines(cast);
---

<Layout title="Home">
	<World />
	<Stage steps={steps} />

	<StepCard id="hello" steps={steps} center>
		<Image src={headshot} alt={resume.name} width={200} height={200} loading="eager" class="photo" />
		<h1 class="name">{resume.name}</h1>
		<p class="tagline">
			Software engineering student at Drexel University building backend, infrastructure, and applied-AI systems.
		</p>
		<p class="seeking">Looking for Spring/Summer 2027 software engineering co-ops and internships.</p>
		<div class="chips">
			<a href="#work">Work ↓</a>
			<a href="#projects">Projects ↓</a>
			<a href="#contact">Contact ↓</a>
		</div>
	</StepCard>

	<StepCard id="work" steps={steps}>
		<h2>Where I've worked</h2>
		<ol class="entries tiles">
			{
				resume.experience.map((job) => (
					<li>
						<h3>
							{job.role} · {job.company}
						</h3>
						<p class="when">
							{job.startDate} – {job.endDate || "Present"}
						</p>
						{job.highlights[0] && <p>{job.highlights[0]}</p>}
					</li>
				))
			}
		</ol>
		<a class="more" href="/work/">See all experience →</a>
	</StepCard>

	<StepCard id="projects" steps={steps}>
		<h2>Things I've built</h2>
		<ul class="entries tiles">
			{
				projects.map((project) => (
					<li class="project">
						<ProjectLogo title={project.data.title} logo={project.data.logo} badge={project.data.monogram} size={48} />
						<div>
							<h3>
								<a href={`/projects/${project.id}/`}>{project.data.title}</a>
							</h3>
							<p>{project.data.description}</p>
							<ul class="tech">
								{project.data.techStack.slice(0, 4).map((tech) => (
									<li>{tech}</li>
								))}
							</ul>
							<ProjectLinks title={project.data.title} repoUrl={project.data.repoUrl} liveUrl={project.data.liveUrl} />
						</div>
					</li>
				))
			}
		</ul>
		<a class="more" href="/projects/">All projects →</a>
	</StepCard>

	{
		posts.length > 0 && (
			<StepCard id="blog" steps={steps}>
				<h2>Writing</h2>
				<ul class="entries">
					{posts.map((post) => (
						<li>
							<h3>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h3>
							<p class="when">
								<time datetime={post.data.date.toISOString()}>{formatDate.format(post.data.date)}</time>
							</p>
							<p>{post.data.description}</p>
						</li>
					))}
				</ul>
				<a class="more" href="/blog/">All posts →</a>
			</StepCard>
		)
	}

	<StepCard id="contact" steps={steps}>
		<h2>Say hello</h2>
		<p>The fastest way to reach me is email.</p>
		<div class="buttons">
			<a class="button email" href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a>
			<a class="button" href={resume.contact.linkedin}>LinkedIn</a>
			<a class="button" href={resume.contact.github}>GitHub</a>
			<a class="button" href="/resume/">Résumé</a>
		</div>
		{
			showHosts && (
				<p slot="after" class="credit" data-world-solid>
					Characters © Nintendo / Game Freak / The Pokémon Company / Atlus / Capcom. Fan art.
					{
						credits.length > 0 && (
							<>
								{" "}Models:{" "}
								{credits.map((credit, index) => (
									<>
										{index > 0 && " · "}
										<a href={credit.url}>{credit.title}</a> by {credit.author} ({credit.licence})
									</>
								))}
							</>
						)
					}
				</p>
			)
		}
	</StepCard>
</Layout>

<style>
	.photo {
		display: block;
		width: 200px;
		height: 200px;
		margin: 0.5rem auto 0;
		object-fit: cover;
		border: 4px solid var(--color-glass-accent);
		border-radius: 50%;
	}

	.name {
		margin: 1rem 0 0.25rem;
		font-size: clamp(2.2rem, 7vw, 3.2rem);
	}

	.tagline {
		margin: 0 auto;
		font-size: 1.15rem;
	}

	.seeking {
		margin: 0.5rem auto 1.25rem;
		font-family: var(--font-heading);
		font-weight: 600;
		color: var(--color-glass-accent);
	}

	.chips,
	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.chips {
		justify-content: center;
	}

	.chips a,
	.button {
		padding: 0.4rem 1rem;
		font-family: var(--font-heading);
		font-weight: 600;
		color: var(--color-on-glass);
		text-decoration: none;
		border: 2px solid var(--color-glass-accent);
		border-radius: 999px;
	}

	.chips a:hover,
	.button:hover {
		color: #0f1a14; /* ink on mint: ≈13:1 */
		background: var(--color-glass-accent);
	}

	.email {
		overflow-wrap: anywhere;
	}

	.entries {
		display: grid;
		gap: 1.25rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}

	.entries h3 {
		margin: 0;
		font-size: 1.1rem;
	}

	.entries p {
		margin: 0;
	}

	.entries .when {
		margin: 0.1rem 0 0.35rem;
		font-size: 0.95rem;
		color: var(--color-glass-muted);
	}

	/* Work and Projects as a bento on desktop: the first entry spans the top, the rest pair up below. */
	.tiles > li {
		max-width: none;
		padding: 1rem 1.15rem;
		border: 1.5px solid var(--color-glass-border);
		border-radius: calc(var(--radius) * 0.75);
	}

	@media (min-width: 48rem) {
		.tiles {
			grid-template-columns: 1fr 1fr;
		}

		/* An even count leaves the last entry alone on its row, so it spans too. */
		.tiles > li:first-child,
		.tiles > li:last-child:nth-child(even) {
			grid-column: 1 / -1;
		}
	}

	.project {
		display: grid;
		grid-template-columns: 48px 1fr;
		gap: 1rem;
		align-items: start;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tech li {
		padding: 0.05rem 0.55rem;
		font-size: 0.8rem;
		border: 1.5px solid var(--color-glass-border);
		border-radius: 999px;
	}

	.more {
		font-family: var(--font-heading);
		font-weight: 600;
	}

	.credit {
		display: none;
		width: fit-content;
		max-width: none;
		margin: 0;
		padding: 0.25rem 0.75rem;
		font-size: 0.8rem;
		color: var(--color-muted);
		background: var(--color-surface);
		border-radius: 999px;
	}

	.credit a {
		color: inherit;
	}

	:global(:root[data-world]) .credit {
		display: block;
	}
</style>
