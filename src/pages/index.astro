---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Window from "../components/Window.astro";
import World from "../components/World.astro";
import { getVisiblePosts } from "../lib/content";
import { sortProjects } from "../lib/projects";
import { resume } from "../lib/resume-data";

const projects = sortProjects(await getCollection("projects"));
const posts = await getVisiblePosts();
const [latestRole] = resume.experience;
---

<Layout title="Home">
	<World />
	<section class="intro" data-world-solid>
		<h1 class="page-title">{resume.name}</h1>
		<p class="tagline">
			Software engineering student at Drexel University building backend, infrastructure, and applied-AI systems.
			Looking for Summer 2027 internships.
		</p>
	</section>

	<div class="desktop">
		<div class="slot slot-projects">
			<Window title="Projects" href="/projects/">
				<p class="muted">{projects.length} projects &amp; open-source contributions</p>
				<ul class="preview">
					{projects.slice(0, 3).map((p) => <li>{p.data.title}</li>)}
				</ul>
				<p class="open">Open →</p>
			</Window>
		</div>
		<div class="slot slot-work">
			<Window title="Work Experience" href="/work/" tone="secondary">
				{
					latestRole && (
						<p>
							<strong>{latestRole.role}</strong>
							<br />
							{latestRole.company} · {latestRole.startDate} – {latestRole.endDate || "Present"}
						</p>
					)
				}
				<p class="muted">{resume.experience.length} roles</p>
			</Window>
		</div>
		<div class="slot slot-blog">
			<Window title="Blog" href="/blog/">
				<p>{posts.length > 0 ? `${posts.length} post${posts.length === 1 ? "" : "s"}` : "Posts coming soon."}</p>
			</Window>
		</div>
		<div class="slot slot-contact">
			<Window title="Contact" href="/contact/" tone="secondary">
				<p class="email">{resume.contact.email}</p>
				<p class="muted">LinkedIn · GitHub · Résumé</p>
			</Window>
		</div>
	</div>
	<div class="runway" aria-hidden="true">
		<p class="runway-hint" data-world-solid>Keep scrolling to explore the town ↓</p>
	</div>
	<p class="credit" data-world-solid>
		Characters © Nintendo / Game Freak / The Pokémon Company / Atlus / Capcom. Fan art.
	</p>
</Layout>

<style>
	.intro {
		width: fit-content;
		max-width: 46rem;
		margin-bottom: 2rem;
		padding: 1.25rem 1.5rem 0.5rem;
		background: var(--color-surface);
		border: 3px solid var(--color-foreground);
		border-radius: var(--radius);
		box-shadow: 6px 6px 0 var(--color-foreground);
	}

	.tagline {
		font-size: 1.15rem;
	}

	/* The "desktop": dotted wallpaper, windows placed on a 12-column grid. */
	.desktop {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding: 1.25rem;
	}

	.slot p {
		margin: 0 0 0.5rem;
	}

	.preview {
		margin: 0 0 0.5rem;
		padding-left: 1.1rem;
	}

	.open {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-secondary);
	}

	.email {
		overflow-wrap: anywhere;
	}

	/* Extra scroll room so the camera can travel to Reshiram's cliff; only while the World is moving. */
	.runway,
	.credit {
		display: none;
	}

	:global(:root[data-world="motion"]) .runway {
		display: block;
		height: 90vh;
	}

	:global(:root[data-world]) .credit {
		display: block;
	}

	.runway-hint {
		width: fit-content;
		margin: 3rem auto 0;
		padding: 0.4rem 1rem;
		font-family: var(--font-heading);
		background: var(--color-surface);
		border: 2px solid var(--color-foreground);
		border-radius: 999px;
	}

	.credit {
		width: fit-content;
		max-width: none;
		margin: 1.5rem auto 0;
		padding: 0.25rem 0.75rem;
		font-size: 0.8rem;
		color: var(--color-muted);
		background: var(--color-surface);
		border-radius: 999px;
	}

	/* Below 768px the windows stack in one column (the grid default above). */
	@media (min-width: 768px) {
		:global(:root[data-world="motion"]) .runway {
			height: 160vh;
		}

		.desktop {
			grid-template-columns: repeat(12, 1fr);
			gap: 2rem;
			padding: 2.5rem;
		}

		.slot-projects {
			grid-column: 1 / span 7;
			grid-row: 1 / span 2;
		}

		.slot-work {
			grid-column: 8 / span 5;
			grid-row: 1;
			margin-top: 1.5rem;
		}

		.slot-blog {
			grid-column: 8 / span 4;
			grid-row: 2;
		}

		.slot-contact {
			grid-column: 3 / span 6;
			grid-row: 3;
		}
	}
</style>
